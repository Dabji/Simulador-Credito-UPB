# ============================================================
# Simulador Credito UPB - Plantilla de variables de entorno
# ============================================================
# Copia este archivo como .env y reemplaza los valores dummy.
# Nunca uses credenciales reales en este archivo de ejemplo.

# ------------------------------------------------------------
# Servidor Backend
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# Base de Datos - MySQL Aiven
# ------------------------------------------------------------
DB_HOST=mysql-aiven-host.example.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=tu_password_mysql_aiven_aqui
DB_SSL=true

# ------------------------------------------------------------
# Autenticacion - JWT y seed administrativo
# ------------------------------------------------------------
JWT_SECRET=tu_secreto_seguro_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=8h
ADMIN_DEFAULT_PASSWORD=password_temporal_admin_solo_para_seed

# ------------------------------------------------------------
# Directorio Activo - LDAP / Active Directory
# ------------------------------------------------------------
LDAP_URL=ldap://ldap.example.edu
LDAP_DOMAIN=example.edu
LDAP_BIND_DN=OU=OU services,DC=example,DC=edu
LDAP_TIMEOUT_MS=5000

# ------------------------------------------------------------
# Servicios de Correo - SMTP
# ------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario_smtp_aqui
SMTP_PASS=password_dummy_smtp_aqui
SMTP_FROM_EMAIL=no-reply@example.edu
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Frontend - Vite
# ------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api

# ------------------------------------------------------------
# Jobs operativos - Retencion y purga automatica
# ------------------------------------------------------------
RETENTION_DAYS=90
PURGE_INTERVAL_HOURS=24
PURGE_BATCH_SIZE=500
TOKEN_PURGE_RETENTION_DAYS=30
TOKEN_PURGE_INTERVAL_HOURS=24
TOKEN_PURGE_BATCH_SIZE=1000
