# ================================
# Simulador Crédito UPB - Environment
# ================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=simulador_credito_upb
DB_USER=root
DB_PASSWORD=your_password_here

# LDAP / Active Directory
LDAP_URL=ldap://ldap.upb.edu.co
LDAP_BIND_DN=cn=admin,dc=upb,dc=edu,dc=co
LDAP_BIND_PASSWORD=ldap_password_here
LDAP_SEARCH_BASE=ou=students,dc=upb,dc=edu,dc=co

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h
