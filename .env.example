# ================================
# Simulador Crédito UPB - Environment
# ================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database (Aiven Cloud)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=

# LDAP / Active Directory
LDAP_URL=ldap://ldap.upb.edu.co
LDAP_BIND_DN=cn=admin,dc=upb,dc=edu,dc=co
LDAP_BIND_PASSWORD=ldap_password_here
LDAP_SEARCH_BASE=ou=students,dc=upb,dc=edu,dc=co

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h

# Email / Nodemailer (SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
FRONTEND_URL=http://localhost:5173

