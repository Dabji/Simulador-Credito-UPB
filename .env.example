# ================================
# Simulador Crédito UPB - Environment
# ================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database (Aiven Cloud)
DB_HOST=your-host.aivencloud.com
DB_PORT=13557
DB_NAME=defaultdb
DB_USER=your_user_here
DB_PASSWORD=your_password_here
DB_SSL=true

# LDAP / Active Directory
LDAP_URL=ldap://ldap.upb.edu.co
LDAP_BIND_DN=cn=admin,dc=upb,dc=edu,dc=co
LDAP_BIND_PASSWORD=ldap_password_here
LDAP_SEARCH_BASE=ou=students,dc=upb,dc=edu,dc=co

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h
