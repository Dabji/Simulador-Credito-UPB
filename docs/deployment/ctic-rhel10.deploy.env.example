# GitHub
GITHUB_TOKEN="__GITHUB_TOKEN_CON_ACCESO_AL_REPOSITORIO_PRIVADO__"
GITHUB_USERNAME="__GITHUB_USERNAME__"
REPO_SLUG="__OWNER__/__REPO__"
GIT_REF="__RAMA_O_TAG_APROBADO__"

# Infraestructura
APP_BASE_DIR=/opt/simulador
APP_DOMAIN=__DOMINIO_PUBLICO_CTIC__
PUBLIC_URL_SCHEME=http
DNF_INSTALL_FLAGS="-y"
SSL_CERT_PATH=__RUTA_CERTIFICADO_PUBLICO__
SSL_KEY_PATH=__RUTA_LLAVE_PRIVADA__
SSL_CA_BUNDLE_PATH=__RUTA_CA_BUNDLE_OPCIONAL__

# Base de datos
DB_HOST=__HOST_O_IP_MARIADB_CTIC__
DB_PORT=3306
DB_NAME=simulador_credito_upb
DB_USER=__USUARIO_MARIADB_CTIC__
DB_PASSWORD=__PASSWORD_MARIADB_CTIC__
DB_SSL=false

# LDAP
LDAP_URL=__LDAP_URL_CTIC__
LDAP_DOMAIN=__LDAP_DOMAIN_CTIC__
LDAP_BASE_DN="__LDAP_BASE_DN_CTIC__"
LDAP_TIMEOUT_MS=5000

JWT_SECRET="__JWT_SECRET_MINIMO_32_CARACTERES__"
JWT_EXPIRES_IN=8h
ADMIN_DEFAULT_PASSWORD="__PASSWORD_TEMPORAL_ADMIN_SEED__"

# SMTP
SMTP_HOST=__SMTP_HOST_CTIC__
SMTP_PORT=587
SMTP_USER=__SMTP_USER_CTIC__
SMTP_PASS=__SMTP_PASSWORD_CTIC__
SMTP_FROM_EMAIL=__SMTP_FROM_EMAIL_CTIC__

# Retencion y purga
RETENTION_DAYS=90
PURGE_INTERVAL_HOURS=24
PURGE_BATCH_SIZE=500
TOKEN_PURGE_RETENTION_DAYS=30
TOKEN_PURGE_INTERVAL_HOURS=24
TOKEN_PURGE_BATCH_SIZE=1000
