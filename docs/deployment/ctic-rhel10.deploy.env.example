# Infraestructura
APP_BASE_DIR=/opt/simulador
APP_DOMAIN=simuladorfinanciaciondirecta.bucaramanga.upb.edu.co
PUBLIC_URL_SCHEME=http

# Base de datos
DB_HOST=REEMPLAZAR_DB_HOST
DB_PORT=3306
DB_NAME=simulador_credito_upb
DB_USER=REEMPLAZAR_DB_USER
DB_PASSWORD="REEMPLAZAR_DB_PASSWORD"
DB_SSL=false

# LDAP
LDAP_URL=ldap://REEMPLAZAR_LDAP_HOST:389
LDAP_DOMAIN=REEMPLAZAR_LDAP_DOMAIN
LDAP_BASE_DN="REEMPLAZAR_LDAP_BASE_DN"
LDAP_TIMEOUT_MS=5000

# JWT y seed
JWT_SECRET="REEMPLAZAR_JWT_SECRET"
JWT_EXPIRES_IN=8h
ADMIN_DEFAULT_PASSWORD="REEMPLAZAR_ADMIN_DEFAULT_PASSWORD"

# SMTP
SMTP_HOST=REEMPLAZAR_SMTP_HOST
SMTP_PORT=587
SMTP_USER="REEMPLAZAR_SMTP_USER"
SMTP_PASS="REEMPLAZAR_SMTP_PASS"
SMTP_FROM_EMAIL="REEMPLAZAR_SMTP_FROM_EMAIL"

# Retencion y purga
RETENTION_DAYS=90
PURGE_INTERVAL_HOURS=24
PURGE_BATCH_SIZE=500
TOKEN_PURGE_RETENTION_DAYS=30
TOKEN_PURGE_INTERVAL_HOURS=24
TOKEN_PURGE_BATCH_SIZE=1000
